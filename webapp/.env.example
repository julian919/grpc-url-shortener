# Copy to .env.local (gitignored). Parsed once, at startup, by src/shared/config/env.ts.
#
# Every var here is SERVER-ONLY on purpose. Nothing is prefixed NEXT_PUBLIC_, because that
# prefix inlines a value into the browser bundle -- and publicweb's secret is a credential
# (RFC 6749 section 4.4: the client-credentials grant is for confidential clients only).

# The Envoy edge, which fronts every gRPC service.
API_BASE_URL=http://localhost:8080

# The client this app authenticates as to read public data (permission: LIST_SHORT_URL).
PUBLICWEB_CLIENT_ID=publicweb

# Dev value; matches the seed in auth/service/src/main/resources/db/dev/R__init_auth.sql, which
# only runs when auth-service is started with the "dev" profile. Any other environment registers
# its own client out of band and supplies that secret here -- see that file's header.
PUBLICWEB_CLIENT_SECRET=publicweb-dev-secret
