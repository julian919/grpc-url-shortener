<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.example</groupId>
    <artifactId>grpc-scaling-workshop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>commons-security</artifactId>
  <name>commons-security</name>
  <description>
    Inbound gRPC security: verifying tokens and enforcing the permissions declared on the proto
    contract. One focused module under commons/, not a catch-all jar -- Cognixus's commons/ is
    two dozen independent modules (server, tracing, logger, kafka...) for the same reason: a
    service that wants tracing should not inherit this module's auth-api dependency.

    commons/ holds TECHNICAL concerns only. No domain code may ever be added here.
  </description>

  <dependencies>
    <!-- The requires_permissions extension this reads off each RPC's MethodOptions. -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>auth-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-grpc-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
